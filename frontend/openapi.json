  "info": {
    "description": "An AI SRE agent that investigates Kubernetes incidents with **read-only** tools, writes a\nroot-cause report with a proposed fix, and applies the fix **only after a human approves it**.\nThe approved action is carried out by a separate executor running under its own RBAC identity.\n\nApprove/reject/dry-run require an approver API key in the `X-API-Key` header.\n",
    "title": "Kubernetes AI Monitor",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/audit": {
      "get": {
        "description": "Append-only log of every state transition and remediation step, newest first.",
        "operationId": "list_audit",
        "parameters": [
          {
            "in": "query",
            "name": "incident_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Incident Id"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 200,
              "maximum": 1000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
