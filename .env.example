# Copy to backend/.env (gitignored) and fill in. Never commit real secrets.

# --- Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=medium
# Server-side refusal fallback (fallbacks: "default"); Claude API only.
ANTHROPIC_REFUSAL_FALLBACK=true

# --- Agent guardrails ---
AGENT_MAX_TOOL_CALLS=15
AGENT_TOOL_TIMEOUT_SECONDS=20
AGENT_TOKEN_BUDGET=600000

# --- Kubernetes (reader identity only; never your admin kubeconfig) ---
MONITOR_READER_KUBECONFIG=../.kube/monitor-reader.kubeconfig

# --- Storage ---
DATABASE_URL=sqlite:///./k8s_ai_monitor.db
