# Copy to .env (repo root, for docker compose) and/or backend/.env (for running from source).
# Both are gitignored. Never commit real secrets.

# --- LLM provider: anthropic (default) or gemini ---
LLM_PROVIDER=anthropic

# --- Gemini (LLM_PROVIDER=gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Claude (LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Reasoning depth for either provider: low | medium | high (Gemini: thinking level).
ANTHROPIC_EFFORT=medium
# Server-side refusal fallback (fallbacks: "default"); Claude API only.
ANTHROPIC_REFUSAL_FALLBACK=true

# --- Agent guardrails ---
AGENT_MAX_TOOL_CALLS=15
AGENT_TOOL_TIMEOUT_SECONDS=20
AGENT_TOKEN_BUDGET=600000

# --- Kubernetes (reader identity only; never your admin kubeconfig) ---
MONITOR_READER_KUBECONFIG=../.kube/monitor-reader.kubeconfig

# --- Storage ---
DATABASE_URL=sqlite:///./k8s_ai_monitor.db

# --- Approval gate (shared by backend and executor) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APPROVAL_SIGNING_KEY=
EXECUTOR_API_KEY=
EXECUTOR_URL=http://localhost:8001
# Approvers as name:key pairs (keys 16+ chars); the name is recorded in the audit log.
APPROVER_API_KEYS=alice:replace-with-a-long-random-key

# --- Executor only (separate process, separate identity) ---
EXECUTOR_KUBECONFIG=../.kube/monitor-executor.kubeconfig
EXECUTOR_ALLOWED_NAMESPACES=demo
EXECUTOR_MAX_MEMORY=4Gi
EXECUTOR_MAX_CPU=4
EXECUTOR_MIN_REPLICAS=1
EXECUTOR_MAX_REPLICAS=20
EXECUTOR_DATABASE_URL=sqlite:///./executor.db
